# Ansible Inventory File
# Konfigurasi managed hosts untuk proyek DevOps To-Do List
# Sesuaikan IP address dan credentials dengan environment Anda

[webservers]
# Server untuk aplikasi frontend dan backend
web1 ansible_host=192.168.1.10 ansible_user=ubuntu
web2 ansible_host=192.168.1.11 ansible_user=ubuntu

[dbservers]
# Server untuk PostgreSQL database
db1 ansible_host=192.168.1.20 ansible_user=ubuntu

[monitoring]
# Server untuk Prometheus dan Grafana
monitor1 ansible_host=192.168.1.30 ansible_user=ubuntu

[kubernetes_master]
# Kubernetes master node
k8s-master ansible_host=192.168.1.100 ansible_user=ubuntu

[kubernetes_workers]
# Kubernetes worker nodes
k8s-worker1 ansible_host=192.168.1.101 ansible_user=ubuntu
k8s-worker2 ansible_host=192.168.1.102 ansible_user=ubuntu

[kubernetes:children]
kubernetes_master
kubernetes_workers

[all:vars]
# SSH connection settings
ansible_ssh_private_key_file=~/.ssh/id_rsa
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
ansible_python_interpreter=/usr/bin/python3
